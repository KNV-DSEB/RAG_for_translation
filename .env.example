# Sao chép tệp này thành `.env` rồi điền giá trị thật.
# `.env` đã bị .gitignore chặn — KHÔNG BAO GIỜ commit key.

# ---- BẮT BUỘC ----
# Lấy miễn phí tại https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# ---- LLM ----
# HAI BẬC MODEL. Free tier giới hạn theo TỪNG MODEL
# (GenerateRequestsPerDayPerProjectPerModel — đo thực tế: gemini-2.5-flash chỉ 20 req/ngày).
# Tách bậc vừa nhân được hạn mức ngày, vừa khớp sức mạnh model với công việc.
#   GEMINI_MODEL       — việc ít nhưng khó: sinh kịch bản, tổng hợp hồ sơ, hỏi đáp tài liệu
#   GEMINI_MODEL_LIGHT — việc nhiều nhưng có cấu trúc: trích thuật ngữ, chấm điểm, lập truy vấn
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MODEL_LIGHT=gemini-3.5-flash-lite
# Hết hạn mức ngày của model chính thì tự chuyển sang model kế tiếp trong danh sách này
GEMINI_FALLBACKS=gemini-3.6-flash,gemini-3.1-flash-lite,gemini-flash-lite-latest,gemini-2.5-flash
LLM_TIMEOUT_SEC=90
LLM_MAX_RETRIES=1
# Giới hạn theo PHÚT thì chờ rồi thử lại được (theo ngày thì phải đổi model)
LLM_RATE_LIMIT_RETRIES=2
LLM_RATE_LIMIT_WAIT_SEC=20

# ---- Embedding (chạy local) ----
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ---- TTS: edge-tts (giọng neural, miễn phí) ----
TTS_VOICE_VI=vi-VN-NamMinhNeural
TTS_VOICE_EN=en-US-JennyNeural

# ---- Research Agent ----
MAX_SEARCH_QUERIES=8
SEARCH_RESULTS_PER_QUERY=8
MIN_GLOSSARY_TERMS=15

# ---- Tài liệu ----
MAX_UPLOAD_MB=25
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=200
RETRIEVAL_TOP_K=10
SCANNED_PDF_CHAR_THRESHOLD=120

# ---- Mock buổi dịch ----
TURN_SENTENCES=5
TURN_MIN_SEC=30
TURN_MAX_SEC=60
# Đo thực tế trên edge-tts, không phải đoán (xem backend/config.py)
WORDS_PER_MIN_VI=228
WORDS_PER_MIN_EN=158
MAX_RECORDING_SEC=180

# ---- Vòng phản hồi §6 ----
MAX_VERDICTS_IN_PROMPT=12

# ---- Hạ tầng ----
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
DEBUG=false

# Nơi cất model embedding tải từ HuggingFace (~470 MB).
# Bỏ trống thì backend tự dùng data/model_cache/ nằm cùng ổ với dự án — cố ý, vì mặc định
# của thư viện là ổ C:, mà C: trên máy này đã đầy.
# HF_HOME=
